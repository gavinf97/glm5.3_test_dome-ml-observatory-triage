# Copy to .env (gitignored) and `chmod 600 .env`. Never paste the key into a shell command.
# Get a key: see SETUP_ZAI.local.md (kept out of git) or https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# The sibling dome-ml-observatory-triage checkout, relative to this folder. Its moros_pipeline/.env
# (not this file) holds the moros connection, used read-only by scripts/export_cohorts.py.
TRIAGE_REPO=../dome-ml-observatory-triage
